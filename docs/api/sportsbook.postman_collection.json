        {
          "name": "Deposit limits",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with daily, weekly and monthly', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data.map(l => l.period)).to.eql(['daily', 'weekly', 'monthly']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/deposit-limits", "host": ["{{base_url}}"], "path": ["deposit-limits"] }
          }
        }
      ]
    },
    {
      "name": "Sign-up and password reset",
      "description": "Needs the code texted to the phone. With SMS_DRIVER=log the code is in storage/logs.",
      "item": [
        {
          "name": "Start sign-up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202: the code was texted', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"phone\": \"{{new_phone}}\",\n    \"password\": \"{{password}}\",\n    \"password_confirmation\": \"{{password}}\",\n    \"adult\": true\n}"
            },
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Resend sign-up code",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n    \"phone\": \"{{new_phone}}\"\n}" },
            "url": { "raw": "{{base_url}}/auth/register/resend", "host": ["{{base_url}}"], "path": ["auth", "register", "resend"] }
          }
        },
        {
          "name": "Finish sign-up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 with a bearer token', () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.environment.set('token', pm.response.json().token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"phone\": \"{{new_phone}}\",\n    \"code\": \"{{code}}\",\n    \"device_name\": \"Postman\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/register/verify", "host": ["{{base_url}}"], "path": ["auth", "register", "verify"] }
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n    \"phone\": \"{{phone}}\"\n}" },
            "url": { "raw": "{{base_url}}/auth/forgot-password", "host": ["{{base_url}}"], "path": ["auth", "forgot-password"] }
          }
        },
        {
          "name": "Reset password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"phone\": \"{{phone}}\",\n    \"code\": \"{{code}}\",\n    \"password\": \"{{password}}\",\n    \"password_confirmation\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/reset-password", "host": ["{{base_url}}"], "path": ["auth", "reset-password"] }
          }
        }
      ]
    },
    {
      "name": "Money and limits",
      "description": "Sends M-Pesa requests or changes responsible-gambling settings that cannot be undone at once (raised limits wait 24 hours; a break cannot be shortened). Not part of the smoke run.",
      "item": [
        {
          "name": "Deposit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.environment.set('deposit_id', pm.response.json().data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n    \"amount\": 100\n}" },
            "url": { "raw": "{{base_url}}/deposits", "host": ["{{base_url}}"], "path": ["deposits"] }
          }
        },
        {
          "name": "Deposit status",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/deposits/{{deposit_id}}", "host": ["{{base_url}}"], "path": ["deposits", "{{deposit_id}}"] }
          }
        },
        {
          "name": "Withdraw",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n    \"amount\": 100\n}" },
            "url": { "raw": "{{base_url}}/withdrawals", "host": ["{{base_url}}"], "path": ["withdrawals"] }
          }
        },
        {
          "name": "Set a deposit limit",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n    \"amount\": 5000\n}" },
            "url": { "raw": "{{base_url}}/deposit-limits/daily", "host": ["{{base_url}}"], "path": ["deposit-limits", "daily"] }
          }
        },
        {
          "name": "Take a break",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"type\": \"cool-off\",\n    \"duration\": \"24h\",\n    \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/exclusions", "host": ["{{base_url}}"], "path": ["exclusions"] }
          }
        }
      ]
    },
    {
      "name": "Session",
      "item": [
        {
          "name": "Log out",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"] }
          }
        },
        {
          "name": "Me after logging out",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401: the token was revoked', () => pm.response.to.have.status(401));",
                  "pm.environment.unset('token');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/me", "host": ["{{base_url}}"], "path": ["me"] }
          }
        }
      ]
    }
  ]
}
