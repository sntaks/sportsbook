APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADMIN_DOMAIN=admin.localhost
SPORTSBOOK_LICENCE_TEXT=

ODDS_API_KEY=
# replay = recordings in database/odds-api-recordings (no credits); live = real API calls
ODDS_API_DRIVER=replay
ODDS_API_REGION=uk
ODDS_API_MARKETS=h2h
ODDS_API_MONTHLY_CREDIT_CAP=500
ODDS_API_CREDIT_RESERVE=50
ODDS_API_LOOKAHEAD_DAYS=7

# textsms = real SMS; log = codes written to the log (local development only, refused in production)
SMS_DRIVER=log
TEXTSMS_API_KEY=
TEXTSMS_PARTNER_ID=
TEXTSMS_SHORTCODE=

# M-Pesa (Daraja). sandbox or production, chosen explicitly (not from APP_ENV).
MPESA_ENV=sandbox
# Random string of 32+ characters; part of every callback URL Safaricom calls.
MPESA_CALLBACK_SECRET=
# Public base URL for callbacks when APP_URL is not reachable from the internet (e.g. a `herd share` URL).
MPESA_CALLBACK_BASE_URL=
# Comma-separated Safaricom callback IPs; empty turns the IP check off.
MPESA_ALLOWED_IPS=
MPESA_C2B_CONSUMER_KEY=
MPESA_C2B_CONSUMER_SECRET=
MPESA_C2B_SHORTCODE=
MPESA_LNMO_PASSKEY=
MPESA_C2B_INITIATOR_NAME=
MPESA_C2B_SECURITY_CREDENTIAL=
MPESA_B2C_CONSUMER_KEY=
MPESA_B2C_CONSUMER_SECRET=
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
